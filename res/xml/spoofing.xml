<!-- The Spoofing screen is drawn with Compose (Spoofing.kt); this file is only the Settings
     search index source and must keep the keys/titles of the entries shown there. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/spoofing_title">

    <!-- Integrity -->
    <PreferenceCategory
        android:key="spoofing_integrity_category"
        android:title="@string/spoofing_integrity_category">

        <!-- TrickyStore -->
        <SwitchPreferenceCompat
            android:key="spoof_trickystore_enabled"
            android:title="@string/tricky_store_title"
            android:summary="@string/tricky_store_summary"
            android:fragment="com.android.settings.spoof.TrickyStore"
            android:defaultValue="true" />

        <!-- Play Integrity Fix -->
        <SwitchPreferenceCompat
            android:key="spoof_pif_enabled"
            android:title="@string/play_integrity_fix_title"
            android:summary="@string/play_integrity_fix_summary"
            android:fragment="com.android.settings.spoof.PlayIntegrityFix"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- Device Identity -->
    <PreferenceCategory
        android:key="spoofing_identity_category"
        android:title="@string/spoofing_identity_category">

        <!-- App Spoofing -->
        <Preference
            android:key="user_selectable_app_spoofing"
            android:title="@string/user_selectable_app_spoofing_title"
            android:summary="@string/user_selectable_app_spoofing_summary"
            android:fragment="com.android.settings.spoof.UserSelectedAppSpoofSettings" />

        <!-- Pixel props -->
        <Preference
            android:key="pi_pp_spoof"
            android:title="@string/spoofing_pixel_props_title"
            android:summary="@string/spoofing_pixel_props_summary"
            android:fragment="com.android.settings.spoof.PixelPropsSettings" />
    </PreferenceCategory>

    <!-- Features -->
    <PreferenceCategory
        android:key="spoofing_features_category"
        android:title="@string/spoofing_features_category">

        <!-- Tensor feature targets -->
        <Preference
            android:key="tensor_targets_settings"
            android:title="@string/tensor_spoof_title"
            android:summary="@string/tensor_spoof_summary"
            android:fragment="com.android.settings.spoof.TensorTargetsSettings" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="spoofing_app_specific_category"
        android:title="@string/spoofing_app_specific_category">

        <!-- Google Photos -->
        <SwitchPreferenceCompat
            android:key="pi_photos_spoof"
            android:title="@string/spoofing_photos_title"
            android:summary="@string/spoofing_photos_summary"
            android:defaultValue="true" />

        <!-- Snapchat -->
        <SwitchPreferenceCompat
            android:key="pi_snapchat_spoof"
            android:title="@string/spoofing_snap_title"
            android:summary="@string/spoofing_snap_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <Preference
        android:key="settings_value_spoof"
        android:title="@string/spoof_settings_title"
        android:summary="@string/settings_spoof_summary"
        android:fragment="com.android.settings.spoof.SettingsValueSpoofSettings" />

    <!-- Reset -->
    <com.android.settingslib.widget.ButtonPreference
        android:key="spoofing_reset_defaults"
        android:title="@string/spoofing_reset_defaults_title"
        android:icon="@drawable/ic_history" />
</PreferenceScreen>
